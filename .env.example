# =============================================================================
#  AVG CRM & MLS Core - Environment Configuration Template
#  کپی کنید به .env و مقادیر را تنظیم کنید.
#  cp .env.example .env
# =============================================================================

# --------------------------------------------------------------------------
#  Node topology
#  LOCAL      -> نرم‌افزار مغازه املاک (انبار محلی، آفلاین-فرست)
#  CLOUD_HUB  -> هاب ابری متمرکز AVG (SaaS Core)
# --------------------------------------------------------------------------
NODE_MODE=LOCAL

APP_NAME=AVG CRM & MLS Core
APP_VERSION=2.0.0-SCRAPER-HYBRID
BRAND_OWNER=AVG - گروه چشم‌انداز اوج فردا
DEBUG=true

# AI is AI-Ready but DISABLED in this commercial release (deterministic/spatial only)
FEATURE_FLAG_AI_ENGINE=false

# --------------------------------------------------------------------------
#  Database (PostgreSQL 16 + PostGIS) - psycopg3 driver works for sync+async
# --------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://avg:avg_secret@localhost:5432/avgcrm

# --------------------------------------------------------------------------
#  Paths (relative to project root unless absolute)
# --------------------------------------------------------------------------
DATA_DIR=data
MEDIA_DIR=data/media

# Manual card-to-card subscription payments. Never enable live receipts until
# the account owner has verified the destination card and a dedicated Fernet
# key has been provisioned through the secret manager.
PAYMENT_METHOD=CARD_TO_CARD
PAYMENT_CARD_NUMBER=0000000000000000
PAYMENT_CARD_HOLDER=چشم‌انداز اوج فردا
PAYMENT_CARD_CONFIGURED=false
PAYMENT_CARD_OWNER_VERIFIED=false
PAYMENT_ENCRYPTION_KEY=
PAYMENT_RECEIPT_MAX_BYTES=8388608
KEYS_DIR=data/keys
LICENSE_FILE=data/license/node.lic

# Zibal is deliberately disabled until a valid merchant, public API Callback,
# official response contract and sandbox flow are confirmed.
ZIBAL_ENABLED=false
ZIBAL_TEST_MODE=true
ZIBAL_MERCHANT=
# Required only for encrypted database-managed credentials. Keep outside the DB.
ZIBAL_CREDENTIAL_ENCRYPTION_KEY=
ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
ZIBAL_VERIFY_URL=https://gateway.zibal.ir/v1/verify
ZIBAL_INQUIRY_URL=https://gateway.zibal.ir/v1/inquiry
ZIBAL_START_URL=https://gateway.zibal.ir/start
# Must be publicly reachable and end with /api/v1/billing/zibal/callback.
ZIBAL_CALLBACK_URL=
# Fixed SHEKARCHI Frontend return URL; never accept a user-supplied redirect.
ZIBAL_RESULT_URL=http://localhost:3000/dashboard/billing
ZIBAL_TIMEOUT_SECONDS=8

# Zibal is deliberately disabled until a valid merchant and public API callback
# are configured. Keep TEST_MODE=true until a controlled sandbox flow is verified.
ZIBAL_ENABLED=false
ZIBAL_TEST_MODE=true
ZIBAL_MERCHANT=
ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
ZIBAL_VERIFY_URL=https://gateway.zibal.ir/v1/verify
ZIBAL_INQUIRY_URL=https://gateway.zibal.ir/v1/inquiry
ZIBAL_START_URL=https://gateway.zibal.ir/start
# Must be publicly reachable and end in /api/v1/billing/zibal/callback.
ZIBAL_CALLBACK_URL=
# Fixed application return URL; never accept a user-supplied return URL.
ZIBAL_RESULT_URL=http://localhost:3000/dashboard/billing
ZIBAL_TIMEOUT_SECONDS=8

# License public key embedded in the on-premise node (RSA-4096)
LICENSE_PUBLIC_KEY_FILE=data/keys/license_public.pem

# --------------------------------------------------------------------------
#  Commercial licensing
# --------------------------------------------------------------------------
OFFLINE_GRACE_DAYS=14
HEARTBEAT_INTERVAL_HOURS=12
# Dev/testing override for machine fingerprint (leave empty in production!)
MACHINE_FINGERPRINT_OVERRIDE=

# --------------------------------------------------------------------------
#  Security
# --------------------------------------------------------------------------
# JWT signing secret for backend API tokens (HS256)
# Generate with: openssl rand -hex 32
# Must be kept secret - compromise allows token forgery
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --------------------------------------------------------------------------
#  Cloud hub / sync (Phase 2)
# --------------------------------------------------------------------------
CLOUD_HUB_BASE_URL=https://hub.avgcrm.com
SYNC_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# HMAC secret for verifying Divar webhook signatures (SHA-256)
# Used to authenticate incoming webhook callbacks from Divar platform
# Generate with: openssl rand -hex 32
DIVAR_WEBHOOK_SECRET=change-me-divar-hmac-secret
# --------------------------------------------------------------------------
#  Divar autonomous scraper (Phase 2 - SCRAPER-HYBRID)
# --------------------------------------------------------------------------
# Master switch: when false, POST /api/v1/scraper/trigger returns 403.
SCRAPER_ENABLED=true
DIVAR_API_BASE_URL=https://api.divar.ir
DIVAR_WEB_BASE_URL=https://divar.ir
# Browser TLS fingerprint (curl_cffi impersonation)
SCRAPER_IMPERSONATE=chrome124
SCRAPER_TIMEOUT_SECONDS=25
SCRAPER_MAX_RETRIES=4
SCRAPER_BASE_BACKOFF_SECONDS=1.5
SCRAPER_BACKOFF_MAX_SECONDS=30
SCRAPER_JITTER_FACTOR=0.5
# Pacing between requests (be polite to Divar)
SCRAPER_PACE_MIN_SECONDS=1.2
SCRAPER_PACE_MAX_SECONDS=3.5
SCRAPER_PAGE_SIZE=24
# Comma-separated crawl targets
SCRAPER_CITIES=tehran
SCRAPER_CATEGORIES=apartment-sell,apartment-rent,house-villa-sell,house-villa-rent
SCRAPER_USER_AGENTS=
PROXY_POOL=
# Phone extraction (on-demand) cache + feature flag
PHONE_EXTRACTION_ENABLED=false
PHONE_CACHE_TTL_SECONDS=86400
PHONE_TTL_SECONDS=86400

# Divar city registry (Phase 2b) — web slugs or Persian labels, comma-separated.
# Each slug is resolved to Divar's numeric city_id via app/services/scraper/cities.py
# Run `python -m app.cli.divar_cities list` to see all supported slugs.
# SCRAPER_CITIES=tehran,mashhad,isfahan,shiraz

# --------------------------------------------------------------------------
#  Scheduled autonomous ingestion (Phase 2b)
# --------------------------------------------------------------------------
# Off by default. When enabled, the node sweeps
# SCRAPER_CITIES x SCRAPER_CATEGORIES on an interval and stores every run as a
# ScrapeJob with trigger=SCHEDULED. Self-gated on the commercial license.
SCRAPER_SCHEDULER_ENABLED=false
SCRAPER_SCHEDULE_INTERVAL_MINUTES=60
SCRAPER_SCHEDULE_JITTER_SECONDS=90
SCRAPER_SCHEDULE_INITIAL_DELAY_SECONDS=30
SCRAPER_SCHEDULE_MAX_PAGES=3
SCRAPER_SCHEDULE_SKIP_OVERLAPPING=true

# =================================================================
# Keycloak / OIDC identity (MASKANCHI-SEC-KEYCLOAK-2026-V1)
# =================================================================
# LICENSE  = offline office node; the commercial licence is the gate.
# KEYCLOAK = every API call must carry a realm token (production posture).
AUTH_MODE=KEYCLOAK
# The public URL browsers use to reach Keycloak. Localhost is for this machine;
# use the host's LAN IP for LAN clients, or the VPS public IP/domain for deployment.
KEYCLOAK_PORT=8082
KEYCLOAK_PUBLIC_URL=http://localhost:8082
# Must equal KEYCLOAK_PUBLIC_URL + /realms/maskanchi exactly — the backend
# verifies tokens with jwt.decode(issuer=...), so a mismatch rejects every
# request with 401 "توکن نامعتبر است".
KEYCLOAK_ISSUER=http://localhost:8082/realms/maskanchi
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8082/realms/maskanchi
KEYCLOAK_AUDIENCE=maskanchi-backend-api
# Required for the legacy FastAPI OTP bridge; use a secret manager, >=32 bytes.
OTP_HMAC_SECRET=
# MelliPayamak remains disabled until panel templates and Body IDs are approved.
# Do not populate the example/pending IDs in a live environment before approval.
MELLIPAYAMAK_ENABLED=false
MELLIPAYAMAK_USERNAME=
MELLIPAYAMAK_PASSWORD=
MELLIPAYAMAK_ENDPOINT=https://rest.payamak-panel.com/api/SendSMS/BaseServiceNumber
MELLIPAYAMAK_TIMEOUT_SECONDS=8
MELLIPAYAMAK_OTP_BODY_ID=
MELLIPAYAMAK_VISIT_BODY_ID=
MELLIPAYAMAK_LEAD_BODY_ID=
MELLIPAYAMAK_SUBSCRIPTION_BODY_ID=
KEYCLOAK_REQUIRED_KYC_STATUS=VERIFIED
JWKS_CACHE_SECONDS=300
PII_QUOTA_HARD_CAP=200

# --- Keycloak Admin API (backs /dashboard/users) ---------------------------
# The user directory is read from the realm, so these credentials decide where
# the staff list comes from. Leaving them blank falls the directory back to the
# local `agency_user` table.
KEYCLOAK_ADMIN_CLIENT_ID=maskanchi-admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_REALM=maskanchi

# Bootstrap admin, used only by scripts/keycloak_bootstrap.py to grant that
# service account its realm-management roles.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Theme cache toggle (true = cache in production, false = live reload in dev)
KC_THEME_CACHE=true

# --------------------------------------------------------------------------
#  Service Ports (core compose)
# --------------------------------------------------------------------------
# You can customize these ports if the defaults conflict with other services
POSTGRES_PORT=5432
REDIS_PORT=6379
KEYCLOAK_PORT=8082
BACKEND_PORT=8080
FRONTEND_PORT=3000
TILES_PORT=8081
# --- Edge web layer (docker-compose.edge.yml) --------------------------------
# Nginx Proxy Manager owns host ports 80/443; the company site (owjfarda) is
# only reachable inside the `avg_edge` network as owjfarda:8080.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_BIND=127.0.0.1
NPM_ADMIN_PORT=81
