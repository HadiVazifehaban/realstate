# Copy the values needed by the account into the private config file
# /home/app/.config/shekarchi/mellipayamak.env (mode 600).
# This Properties file is read by the Keycloak SPI from a Docker secret mount.
# Do not put credentials in this example, Compose environment, or the image.

# Keep false until the panel credentials, approved OTP pattern, Body ID,
# and current account API response contract have been verified.
MELLIPAYAMAK_ENABLED=false

# Required by BaseServiceNumber. No sender number is required for this
# shared-service-number operation.
MELLIPAYAMAK_USERNAME=
MELLIPAYAMAK_PASSWORD=

# Official REST sample endpoint; change only to an account-approved endpoint.
MELLIPAYAMAK_ENDPOINT=https://rest.payamak-panel.com/api/SendSMS/BaseServiceNumber
MELLIPAYAMAK_CONNECT_TIMEOUT_MS=5000
MELLIPAYAMAK_TIMEOUT_MS=8000

# Required and account-specific. Keep blank until approved in the panel.
MELLIPAYAMAK_OTP_BODY_ID=

# Optional non-authentication patterns. Keep blank unless approved.
MELLIPAYAMAK_VISIT_BODY_ID=
MELLIPAYAMAK_LEAD_BODY_ID=
MELLIPAYAMAK_SUBSCRIPTION_BODY_ID=
